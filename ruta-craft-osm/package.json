{
  "name": "ruta-craft-osm",
  "version": "0.1.0",
  "description": "Cálculo de rutas multi-parada offline sobre grafos de OpenStreetMap, con motor nativo en C++ para Node.js y Electron",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "npm run build && node --test src/test-motor.cjs",
    "demo": "npm run build && node src/test-calcularRuta.cjs"
  },
  "keywords": [
    "rutas",
    "openstreetmap",
    "osm",
    "a-star",
    "navegacion",
    "electron",
    "offline"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Mahynlo/RutaCraftOSM.git",
    "directory": "ruta-craft-osm"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "",
  "license": "",
  "devDependencies": {
    "@types/node": "^24.0.4",
    "typescript": "^5.8.3"
  }
}
